# Copy to .env and fill in. Never commit the real .env file.

# --- Database ---
POSTGRES_DB=ragdb
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Ollama (runs on your machine, no API key) ---
# Used by the containers. From IntelliJ the default http://localhost:11434 is used.
OLLAMA_BASE_URL=http://host.docker.internal:11434
CHAT_MODEL=llama3.2
# Install first: ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text
# Must equal the embedding model's vector size (768 for nomic-embed-text).
EMBEDDING_DIMENSIONS=768

# --- Gateway ---
GATEWAY_PORT=8080

# --- Story 1: ingestion and chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- Story 2: dynamic ingestion security ---
VENDOR_WEBHOOK_SECRET=change-me
# Comma-separated allowlist, for example: docs.example.com,github.com
INGEST_ALLOWED_DOMAINS=
INGEST_MAX_SIZE_MB=20

# --- Stories 3 and 4: retrieval tuning ---
RETRIEVAL_TOP_K=20
SIMILARITY_THRESHOLD=0.70
QUERY_EXPANSION_VARIANTS=3
RERANK_TOP_K=5
STITCH_TOKEN_BUDGET=2000
